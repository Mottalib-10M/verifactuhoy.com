---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'verifactu-check', h2: 'Verifactu check', text: 'Four answers, and your readers see whether Verifactu applies to them and by when their software must comply.', t: 'Does Verifactu apply to me?', h: 760 },
  { name: 'qr-reader', h2: 'Tax QR reader', text: 'Reads the QR code on an invoice and opens the official AEAT matching page. The image stays on your readers’ device.', t: 'Verifactu QR reader', h: 760 },
  { name: 'b2b-check', h2: 'B2B e-invoicing check', text: 'Shows from when B2B e-invoicing is mandatory under RD 238/2026, by turnover and legal form.', t: 'Spanish B2B e-invoicing date', h: 720 },
];
---
<PageLayout title="Embed the Verifactu tools for free: check, QR reader, B2B date" description="Embed the Verifactu check, the tax QR reader and the B2B e-invoicing checker for free with an iframe: copy the code once, new dates arrive by themselves." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the Verifactu tools</h1>
    <p class="mt-3 text-lg text-navy-700">For associations, professional bodies, accounting firms and chambers: copy once, and new dates appear by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>For the Spanish version, replace <code>/embed/en/</code> with <code>/embed/es/</code>. Terms: the source link under the tool stays visible, the tool is not altered and is provided without warranty. What your readers enter stays on their device. Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/verifactu-check/`} title="Does Verifactu apply to me?" width="100%" height="760" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
